# Copy to apps/web/.env.local and fill in from the Supabase dashboard.
# Development points at the `job-tracker-dev` project; the deployment's
# environment variables point at `job-tracker-prod` (ADR-0003). There is no
# local Supabase stack — both environments are cloud projects.
#
# See docs/setup/supabase.md for where each value lives in the dashboard.

# Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Project Settings → API Keys → anon / publishable key.
# Safe to expose: it grants nothing on its own, only what a signed-in session allows.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Project Settings → Database → Connection string → Transaction pooler (port 6543).
# The application connects here. Prepared statements must be disabled on this
# path, which is why the pooled and direct URLs are two separate variables
# rather than one switched by environment.
DATABASE_URL="postgresql://postgres.your-project-ref:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Project Settings → Database → Connection string → Direct connection (port 5432).
# Migration tooling uses this: the transaction pooler cannot run session-level DDL.
DIRECT_URL="postgresql://postgres.your-project-ref:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
