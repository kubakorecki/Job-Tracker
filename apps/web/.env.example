# Copy to apps/web/.env.local and fill in from the Supabase dashboard.
# Development points at the `job-tracker-dev` project; the deployment's
# environment variables point at `job-tracker-prod` (ADR-0003). There is no
# local Supabase stack — both environments are cloud projects.
#
# See docs/setup/supabase.md for where each value lives in the dashboard.

# Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Project Settings → API Keys → anon / publishable key.
# Safe to expose: it grants nothing on its own, only what a signed-in session allows.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Project Settings → Database → Connection string → Transaction pooler (port 6543).
# The application connects here. Prepared statements must be disabled on this
# path, which is why the pooled and direct URLs are two separate variables
# rather than one switched by environment.
#
# Use the pooler host (`...pooler.supabase.com`), not `db.<ref>.supabase.co`:
# the direct host resolves to IPv6 only, and most home and CI networks have no
# route to it. The username carries the project ref — `postgres.<ref>`.
DATABASE_URL="postgresql://postgres.your-project-ref:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Project Settings → Database → Connection string → Session pooler (port 5432).
# Migration tooling uses this: the transaction pooler cannot run session-level
# DDL. The session pooler is the same connection over IPv4; the "Direct
# connection" the dashboard offers alongside it is IPv6-only.
DIRECT_URL="postgresql://postgres.your-project-ref:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# The browser extension's origin. Its id is derived from the public `key` in
# apps/extension/wxt.config.ts, so every build of this repository is the same
# extension and the value below is the value to use — here and in the
# deployment. The API's CORS allowlist covers it; outside a deployment it also
# covers http://localhost:3000, and every other origin is refused.
#
# Several may be listed, separated by commas: a store build is signed with a
# different key and is therefore a different extension with a different id.
EXTENSION_ORIGIN="chrome-extension://okeljopaafaojopfkhjioaceeohjplhb"

# AI Studio → Get API key. The extraction endpoint is the only thing that reads
# it, so a dashboard-only deployment and every test run start without it: the
# API tests substitute the extraction function itself and never call Gemini.
#
# It is a developer key with a free grant attached, not a consumer
# subscription. When the grant runs out the endpoint answers `provider_error`
# and says so — there is no quieter, cheaper model behind it.
GEMINI_API_KEY=""
